<script>
require([
    'jquery',
    'Magento_Ui/js/modal/confirm',
    'Magento_Ui/js/modal/prompt',
    'mage/translate',
    'mage/validation',
    'domReady!'
], function ($, confirm, prompt) {
    'use strict';

    /**
     * Magento-styled confirm. opts: { title, content, onConfirm }
     */
    function mageConfirm(opts) {
        confirm({
            title: opts.title || $.mage.__('Confirm'),
            content: opts.content || '',
            actions: {
                confirm: function () {
                    if (typeof opts.onConfirm === 'function') opts.onConfirm();
                },
                cancel: function () {}
            },
            buttons: [{
                text: $.mage.__('Cancel'),
                class: 'action-secondary action-dismiss',
                click: function () { this.closeModal(); }
            }, {
                text: opts.confirmText || $.mage.__('OK'),
                class: 'action-primary action-accept',
                click: function (e) { this.closeModal(e, true); }
            }]
        });
    }

    /**
     * Magento-styled prompt. opts: { title, content, value, onConfirm }
     */
    $.validator.addMethod('validate-panth-mm-view-name', function (value) {
        return $.trim(value || '') !== '';
    }, $.mage.__('Enter a name for the view.'));

    function magePrompt(opts) {
        prompt({
            title: opts.title || $.mage.__('Enter value'),
            content: opts.content || '',
            value: opts.value || '',
            validation: true,
            validationRules: ['validate-panth-mm-view-name'],
            attributesField: {
                name: 'panth_mm_view_name',
                maxlength: 128,
                'aria-required': 'true'
            },
            actions: {
                confirm: function (val) {
                    var clean = (val || '').toString().trim();
                    if (clean === '') return;
                    if (typeof opts.onConfirm === 'function') opts.onConfirm(clean);
                },
                cancel: function () {}
            },
            buttons: [{
                text: $.mage.__('Cancel'),
                class: 'action-secondary action-dismiss',
                click: function () { this.closeModal(); }
            }, {
                text: opts.confirmText || $.mage.__('OK'),
                class: 'action-primary action-accept',
                click: function (e) { this.closeModal(e, true); }
            }]
        });
    }

    /* -------- Expand / collapse tree -------- */
    var viewId = $('#panth-mm-form input[name="view_id"]').val() || '0';
    var lsKey = 'panth-mm-collapsed:' + viewId;
    /**
     * Stored shape: { __initialised: 1, "<id>": 1, ... }
     * The marker tells us whether this view's tree state has ever been
     * persisted; the first ever load defaults to "everything below L0
     * collapsed" so 326-row pages don't lay out 326 expanded rows on
     * first paint.
     */
    var collapsed = {};
    try {
        var stored = window.localStorage.getItem(lsKey);
        if (stored) collapsed = JSON.parse(stored) || {};
    } catch (e) {}
    if (!collapsed.__initialised) {
        $('#panth-mm-tbody > tr[data-has-children="1"]').each(function () {
            collapsed[$(this).attr('data-id')] = 1;
        });
        collapsed.__initialised = 1;
    }

    function persistCollapsed() {
        try { window.localStorage.setItem(lsKey, JSON.stringify(collapsed)); } catch (e) {}
    }

    function isAncestorCollapsed(id) {
        var $row = $('#panth-mm-tbody > tr[data-id="' + cssEscape(id) + '"]').first();
        if (!$row.length) return false;
        var parentId = $row.attr('data-parent-id') || '';
        while (parentId) {
            if (collapsed[parentId]) return true;
            var $p = $('#panth-mm-tbody > tr[data-id="' + cssEscape(parentId) + '"]').first();
            parentId = $p.attr('data-parent-id') || '';
        }
        return false;
    }

    function applyCollapsedState() {
        $('#panth-mm-tbody > tr').each(function () {
            var $tr = $(this);
            var id = $tr.attr('data-id');
            var hidden = isAncestorCollapsed(id);
            $tr.toggleClass('panth-mm__row--hidden-by-collapse', hidden);
            var isCollapsed = !!collapsed[id];
            $tr.toggleClass('panth-mm__row--collapsed', isCollapsed);
            $tr.find('.panth-mm__chev-btn').attr('aria-expanded', isCollapsed ? 'false' : 'true');
        });
    }

    function cssEscape(s) {
        return String(s).replace(/(["\\])/g, '\\$1');
    }

    $('#panth-mm-tbody').on('click', '.panth-mm__chev-btn', function () {
        var $row = $(this).closest('tr');
        var id = $row.attr('data-id');
        if (!id) return;
        if (collapsed[id]) { delete collapsed[id]; } else { collapsed[id] = 1; }
        persistCollapsed();
        applyCollapsedState();
    });

    $('#panth-mm-expand-all').on('click', function () {
        collapsed = {};
        persistCollapsed();
        applyCollapsedState();
    });
    $('#panth-mm-collapse-all').on('click', function () {
        collapsed = {};
        $('#panth-mm-tbody > tr[data-has-children="1"]').each(function () {
            collapsed[$(this).attr('data-id')] = 1;
        });
        persistCollapsed();
        applyCollapsedState();
    });

    applyCollapsedState();

    /* -------- Quick search (also clears collapse so matches show) -------- */
    var search = document.getElementById('panth-mm-search');
    var rows = function () { return document.querySelectorAll('.panth-mm__row'); };
    if (search) {
        search.addEventListener('input', function () {
            var q = (search.value || '').trim().toLowerCase();
            var tokens = q.split(/\s+/).filter(Boolean);
            Array.prototype.forEach.call(rows(), function (r) {
                if (!q) { r.classList.remove('panth-mm__row--filtered-out'); return; }
                var hay = r.getAttribute('data-search') || '';
                var hit = tokens.every(function (t) { return hay.indexOf(t) !== -1; });
                r.classList.toggle('panth-mm__row--filtered-out', !hit);
            });
            // While searching, ignore collapse state so matches are visible.
            $('.panth-mm__row').toggleClass('panth-mm__row--searching', !!q);
        });
    }

    /* -------- Reset row -------- */
    $('.panth-mm__reset').on('click', function () {
        var id = $(this).data('id');
        if (!id) return;
        mageConfirm({
            title: $.mage.__('Clear menu override'),
            content: $.mage.__('Clear the stored override for') + ' <code>' + $('<div/>').text(id).html() + '</code>?',
            confirmText: $.mage.__('Clear'),
            onConfirm: function () {
                $('#panth-mm-reset-id').val(id);
                $('#panth-mm-reset-form').trigger('submit');
            }
        });
    });

    /* -------- Enabled toggle visual -------- */
    $('.panth-mm__switch input[type="checkbox"]').on('change', function () {
        $(this).closest('tr').toggleClass('panth-mm__row--disabled', !this.checked);
    });

    /* -------- View switcher dropdown -------- */
    var $viewSelect = $('#panth-mm-view-select');
    function currentViewId() { return parseInt($viewSelect.val(), 10) || 0; }
    function currentViewLabel() { return $viewSelect.find('option:selected').text().split('(')[0].trim(); }

    $viewSelect.on('change', function () {
        var url = $viewSelect.find('option:selected').data('switch-url');
        if (url) window.location.href = url;
    });
    $('#panth-mm-view-activate-me').on('click', function () {
        $('#panth-mm-view-activate-id').val(currentViewId());
        $('#panth-mm-view-activate-scope').val('me');
        $('#panth-mm-view-activate-form').trigger('submit');
    });
    function escapeHtml(s) {
        return $('<div/>').text(s == null ? '' : String(s)).html();
    }

    $('#panth-mm-view-activate-global').on('click', function () {
        var label = currentViewLabel();
        mageConfirm({
            title: $.mage.__('Set as system default'),
            content: $.mage.__('Make') + ' <strong>' + escapeHtml(label) + '</strong> '
                   + $.mage.__('the system default for everyone without a personal preference?'),
            confirmText: $.mage.__('Set as default'),
            onConfirm: function () {
                $('#panth-mm-view-activate-id').val(currentViewId());
                $('#panth-mm-view-activate-scope').val('global');
                $('#panth-mm-view-activate-form').trigger('submit');
            }
        });
    });
    $('#panth-mm-view-new').on('click', function () {
        magePrompt({
            title: $.mage.__('New view'),
            content: $.mage.__('Name the new view:'),
            value: '',
            confirmText: $.mage.__('Create'),
            onConfirm: function (label) {
                $('#panth-mm-view-save-id').val('');
                $('#panth-mm-view-save-label').val(label);
                $('#panth-mm-view-save-form').trigger('submit');
            }
        });
    });
    $('#panth-mm-view-rename').on('click', function () {
        magePrompt({
            title: $.mage.__('Rename view'),
            content: $.mage.__('Rename view to:'),
            value: currentViewLabel(),
            confirmText: $.mage.__('Rename'),
            onConfirm: function (label) {
                $('#panth-mm-view-save-id').val(currentViewId());
                $('#panth-mm-view-save-label').val(label);
                $('#panth-mm-view-save-form').trigger('submit');
            }
        });
    });
    $('#panth-mm-view-duplicate').on('click', function () {
        magePrompt({
            title: $.mage.__('Duplicate view'),
            content: $.mage.__('Name for the duplicated view:'),
            value: currentViewLabel() + ' copy',
            confirmText: $.mage.__('Duplicate'),
            onConfirm: function (label) {
                $('#panth-mm-view-duplicate-id').val(currentViewId());
                $('#panth-mm-view-duplicate-label').val(label);
                $('#panth-mm-view-duplicate-form').trigger('submit');
            }
        });
    });
    $('#panth-mm-view-delete').on('click', function () {
        var label = currentViewLabel();
        mageConfirm({
            title: $.mage.__('Delete view'),
            content: $.mage.__('Delete view') + ' <strong>' + escapeHtml(label) + '</strong>? '
                   + $.mage.__('All its overrides will be discarded.'),
            confirmText: $.mage.__('Delete'),
            onConfirm: function () {
                $('#panth-mm-view-delete-id').val(currentViewId());
                $('#panth-mm-view-delete-form').trigger('submit');
            }
        });
    });

    /* -------- Per-item colour accent ----------
     * The hidden input is the source of truth (what gets posted).
     * The native <input type="color"> just drives picking; on change it
     * copies its value into the hidden input and updates the swatch
     * preview. The × button clears both. */
    $('#panth-mm-tbody').on('input change', '.panth-mm__color-input', function () {
        var $cell = $(this).closest('.panth-mm__color-cell');
        var val = (this.value || '').toLowerCase();
        $cell.find('.panth-mm__color-hidden').val(val);
        $cell.css('--swatch', val);
        $cell.addClass('panth-mm__color-cell--set');
    });
    $('#panth-mm-tbody').on('click', '.panth-mm__color-clear', function () {
        var $cell = $(this).closest('.panth-mm__color-cell');
        $cell.find('.panth-mm__color-hidden').val('');
        $cell.css('--swatch', 'transparent');
        $cell.removeClass('panth-mm__color-cell--set');
    });

    /* -------- Live preview of bi-* icon next to its input ---------- */
    function updateIconPreview(input) {
        var $input = $(input);
        var val = (input.value || '').trim();
        var $preview = $input.closest('.panth-mm__icon-wrap').find('.panth-mm__icon-preview');
        $preview.empty();
        if (!val) return;
        if (/^bi-[a-z0-9-]+$/i.test(val)) {
            $preview.append('<i class="bi ' + val.toLowerCase() + '"></i>');
        } else {
            $preview.append('<span class="panth-mm__icon-glyph">' + escapeHtml(val) + '</span>');
        }
    }
    $('#panth-mm-tbody').on('input change', '.panth-mm__input--icon', function () {
        updateIconPreview(this);
    });

    /* -------- Lazy-populate parent <select>s on first focus --------
     * Initial render only contains each select's currently selected option
     * (~326 options total page-wide). The full options list is cloned in
     * from #panth-mm-parent-options-template the first time the user
     * interacts with a particular select. */
    var parentOptionsHtml = null;
    function getParentOptionsHtml() {
        if (parentOptionsHtml === null) {
            var tpl = document.getElementById('panth-mm-parent-options-template');
            parentOptionsHtml = tpl ? tpl.innerHTML : '';
        }
        return parentOptionsHtml;
    }

    function populateParentSelect(sel) {
        if (sel.dataset.panthLoaded === '1') return;
        var $sel = $(sel);
        var currentValue = sel.dataset.currentValue || '';
        var stockLabel = sel.dataset.stockLabel || '';
        var defaultParent = sel.dataset.defaultParent || '';
        var selfId = sel.dataset.selfId || '';

        // Build the prefix: "use stock" sentinel, "Top level" sentinel, then
        // a disabled separator before the full alphabetised picker.
        var prefix =
            '<option value="">↳ ' + $.mage.__('Use stock parent') + ' (' + stockLabel + ')</option>'
          + '<option value="__root__">⤴ ' + $.mage.__('Move to top level') + '</option>'
          + '<option value="" disabled>──────────</option>';

        // Strip the row's own id from the cloned options so a row can't
        // become its own parent.
        var allOptions = getParentOptionsHtml();
        if (selfId) {
            // Cheap, exact-match drop using a regex with the escaped id.
            var safeId = selfId.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
            var re = new RegExp('<option value="' + safeId + '">[^<]*</option>', 'g');
            allOptions = allOptions.replace(re, '');
        }

        $sel.html(prefix + allOptions);
        // Restore the original selection.
        sel.value = currentValue;
        sel.dataset.panthLoaded = '1';
    }

    function effectiveParentOf(row) {
        var sel = row.querySelector('.panth-mm__select-parent');
        var value = sel ? (sel.dataset.panthLoaded === '1' ? sel.value : (sel.dataset.currentValue || '')) : '';
        if (value === '__root__') return '';
        return value !== '' ? value : (row.getAttribute('data-default-parent') || '');
    }

    function descendantsOf(selfId) {
        var childrenOf = {};
        Array.prototype.forEach.call(rows(), function (row) {
            var parent = effectiveParentOf(row);
            (childrenOf[parent] = childrenOf[parent] || []).push(row.getAttribute('data-id'));
        });
        var found = {};
        var queue = (childrenOf[selfId] || []).slice();
        while (queue.length) {
            var id = queue.shift();
            if (found[id] || id === selfId) continue;
            found[id] = true;
            queue = queue.concat(childrenOf[id] || []);
        }
        return found;
    }

    function excludeDescendants(sel) {
        var selfId = sel.dataset.selfId || '';
        if (!selfId) return;
        var blocked = descendantsOf(selfId);
        Array.prototype.forEach.call(sel.options, function (opt) {
            if (opt.value === '' || opt.value === '__root__') return;
            var isBlocked = !!blocked[opt.value] && opt.value !== sel.value;
            opt.disabled = isBlocked;
            opt.hidden = isBlocked;
        });
    }

    $('#panth-mm-tbody').on('focusin mousedown', '.panth-mm__select-parent', function () {
        populateParentSelect(this);
        excludeDescendants(this);
    });
    // Also populate before submit so the form posts the right value if
    // a user changed it via keyboard without focus events firing.
    $('#panth-mm-form').on('submit', function () {
        $('.panth-mm__select-parent').each(function () { populateParentSelect(this); });
    });

});
</script>
